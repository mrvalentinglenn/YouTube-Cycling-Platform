YOUTUBE_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# HEALTHCHECKS_URL is deliberately NOT set locally.
# It lives in GitHub Secrets only. If a laptop had it, a manual test run
# would ping Healthchecks and reset the timer — silencing an alarm about
# the scheduled job having failed to run, at exactly the moment the alarm
# was doing its job. collect.py treats it as optional and logs the skip.
HEALTHCHECKS_URL=